# ---------- Web (public, bundled into client; contains NO secrets) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_API_BASE=/api

# ---------- Server only (Vercel project env vars; NEVER prefix with VITE_) ----------
# base64 of the service-account JSON:  base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=
# Razorpay TEST keys only (rzp_test_...). Leave empty to use the labelled demo checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public deployed HTTPS URL, e.g. https://your-califnco-domain.vercel.app (required for hosted payment callbacks)
APP_BASE_URL=
# EmailJS (server-side REST call needs a private key; enable "Allow API access from non-browser" is NOT required when using the private key)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
